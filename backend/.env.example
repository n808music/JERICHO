# Jericho backend environment variables
# Copy to .env and fill in values

# State persistence (Phase 0: JSON file, Phase 2: Supabase)
STATE_PATH=../src/data/state_good.json

# Supabase (Phase 2+)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (Phase 1+)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3-8b

# Security
JWT_SECRET=changeme
CREDENTIAL_ENCRYPTION_KEY=

# OpenTelemetry (Phase 1+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=jericho-backend

# Server
PORT=8000
