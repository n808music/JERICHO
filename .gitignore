node_modules
coverage
.DS_Store
dist
*.log
# Baseline captures are evidence, not noise. Every failing-set diff is derived
# from the raw run logs, and the *.log rule above silently dropped them while
# keeping the derived lists -- leaving a comparator no one could re-verify.
!**/BASELINE_*/*.log
.worktrees
venv/
__pycache__/
*.db
.claude/
tmp/
tmp-*
data-store.json
vite.config.mjs.timestamp-*
debug_activate_tmp.mjs
runtime_proof.mjs
*.head_test
