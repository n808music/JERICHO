import { describe, expect, it } from 'vitest';

import { buildSampleProfileFixtureState } from '../../src/dev/sampleProfileRestore.js'';
import { buildPersistableIdentityState, rehydratePersistedState } from '../../src/state/identityStore.js';
import { DEFAULT_PROFILE_ID } from '../../src/state/identityStore.js';

describe('master-plan scheduled agenda metadata', () => {
  it('rehydrates a profile-owned current agenda version for Operation Endgame', () => {
    const state = buildSampleProfileFixtureState();
    const persisted = buildPersistableIdentityState(state);
    const rehydrated = rehydratePersistedState(persisted);

    const profile = rehydrated.profilesById?.[DEFAULT_PROFILE_ID] || null;
    const planId = profile?.activeMasterPlanId || null;
    const plan = planId ? rehydrated.masterPlansById?.[planId] || null : null;
    const agendaId = plan?.currentAgendaVersionId || null;
    const agenda = agendaId ? rehydrated.masterPlanAgendaVersionsById?.[agendaId] || null : null;
    const constraintId = plan?.currentScheduleConstraintVersionId || null;
    const constraint = constraintId ? rehydrated.scheduleConstraintVersionsById?.[constraintId] || null : null;

    expect(planId).toBeTruthy();
    expect(agenda?.profileId).toBe(DEFAULT_PROFILE_ID);
    expect(agenda?.masterPlanId).toBe(planId);
    expect(agenda?.state).toBe('current');
    expect(agenda?.range?.endDayKey).toBe('2031-05-19');
    expect(agenda?.blockCount).toBe((rehydrated.fullHorizonScheduleBlocks || []).length);
    expect(agenda?.quality?.strategicCoverageState).toBe('covered');
    expect(profile?.agendaVersionIds || []).toContain(agendaId);
    expect(profile?.scheduleConstraintVersionIds || []).toContain(constraintId);
    expect(constraint?.source).toBe('master_calendar');
    expect(constraint?.constraintHash).toBeTruthy();
    expect(constraint?.weeklyCapacityMinutes || 0).toBeGreaterThan(0);
    expect(rehydrated.today?.blocks || []).toEqual([]);
    expect((rehydrated.fullHorizonScheduleBlocks || []).every((block) => block.executionEligible === false)).toBe(true);
  });
});
