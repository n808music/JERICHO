{
  "name": "jericho-system",
  "version": "0.1.0",
  "description": "Jericho closed-loop behavioral execution MVP",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "STATE_PATH=src/data/state_good.json node src/api/server.js",
    "dev:api:watch": "STATE_PATH=src/data/state_good.json nodemon src/api/server.js",
    "dev:client": "vite dev --port 5183 --strictPort",
    "build": "npm run lint && npm test && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src tests",
    "validate": "node scripts/validate.js"
  },
  "keywords": [
    "jericho",
    "identity",
    "tasks",
    "reinforcement"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-jest": "^30.3.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.10"
  }
}
